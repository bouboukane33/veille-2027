{
  "lookback_days": 30,
  "max_news_per_personality": 30,
  "max_youtube_videos_per_personality": 10,
  "enable_news": true,
  "enable_youtube": true,
  "rss_feeds": [
    "https://www.francetvinfo.fr/politique.rss",
